# Used by `bun run dev` (Bun reads .env) and drizzle-kit.
# For `wrangler dev`, put the same keys in .dev.vars.
# Postgres from docker compose. For your own local Postgres, use its URL instead.
DATABASE_URL=postgres://fugo:fugo@localhost:5433/fugo
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-4-hydrogen
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_THINKING_LEVEL=low
AI_TIMEOUT_MS=25000
ADMIN_EMAIL=admin@fugo.test
ADMIN_PASSWORD=change-me
# Any long random string, for example: openssl rand -base64 32
SESSION_SECRET=
PORT=8787
