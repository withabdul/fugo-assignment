{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fugo-brief-hub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-18",
  // postgres.js needs Node's net/tls APIs, which Workers provide with this flag.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_TEXT_MODEL": "gemini-4-hydrogen",
    "GEMINI_DECISION_MODEL": "gemini-decision-1",
    "AI_TIMEOUT_MS": "25000"
  }
  // Secrets (set with `wrangler secret put <NAME>`, never in this file):
  // DATABASE_URL, GEMINI_API_KEY, ADMIN_EMAIL, ADMIN_PASSWORD, SESSION_SECRET
}
