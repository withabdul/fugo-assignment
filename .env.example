# Only for `docker compose up` (for example on a VPS). For `bun run dev`, use apps/api/.env instead.
# Password for the Postgres container. Use a long random value; it must be URL-safe.
POSTGRES_PASSWORD=
GEMINI_API_KEY=
ADMIN_EMAIL=admin@fugo.test
ADMIN_PASSWORD=change-me
# Any long random string, for example: openssl rand -base64 32
SESSION_SECRET=
